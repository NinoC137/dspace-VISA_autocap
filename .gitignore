# controldesk_automation — what this repository tracks
#
# Boundary rule: **source only.** Anything the bench *produces* at runtime, and
# anything *machine-local*, stays out of Git. This is deliberately the same
# boundary documented in docs/DIRECTORY_LAYOUT.md for deployment to
# F:\ZYS_HYBASE\automation, so `git status` and a deployment diff agree on what
# is "the project" versus "what the project leaves behind".
#
# If a path here is also a preserved deployment path, it is excluded on purpose:
# it must survive on the rig but must never travel through Git.


# ---------------------------------------------------------------------------
# Machine-local generated dependencies
# ---------------------------------------------------------------------------
# The rig's Python runtime lives here (~273 MB, 7000+ files) and is rebuilt by
# SETUP_SCOPE_BENCH.cmd on each machine. It is never copied between machines and
# is not relocatable, so it is never committed.
scope_bench/.venv/
.venv/
venv/

# Import caches. Note the workspace root .gitignore also covers these; repeated
# here so this project stays correct if it is ever split into its own repo.
__pycache__/
*.py[cod]
*.pyo


# ---------------------------------------------------------------------------
# Machine-local run state
# ---------------------------------------------------------------------------
# GUI session state and stop markers, written per run by scope_bench/ui.py.
scope_bench/sessions/

# Desktop smoke-test output (probe logs, panel screenshots, result JSON).
scope_bench/desktop_test_*/


# ---------------------------------------------------------------------------
# Runtime measurement output
# ---------------------------------------------------------------------------
# Scope captures and sweep datasets. Large and regenerated by running the bench;
# on work-pc this is the CIFS target of the Pi share and the rig's live data.
#
# Every pattern below is anchored with a leading "/" so it only applies at the
# project root, where deployment actually places these directories. Unanchored
# globs are dangerous here: "*_validation_*/" would also swallow the tracked
# source directory test_cases/phase_angle_validation_01/.
/scope_results/
/sweep_results/


# ---------------------------------------------------------------------------
# Historical / retained artifacts
# ---------------------------------------------------------------------------
# Deployment rollback copies. These are created on work-pc before a migration
# and are the rollback path for the production root — keep them on the rig.
/backup_*/

# Validation evidence from earlier bench sessions. The data is retained locally
# and on the rig for traceability, but is output, not source.
/validation/
/*_validation_*/
/pi_validation_*/

# ControlDesk parameter inventories (timestamped snapshot directories).
/parameter_snapshots/


# ---------------------------------------------------------------------------
# Panel runtime logs
# ---------------------------------------------------------------------------
# mxo38_panel/server.mjs appends a JSONL line per action.
mxo38_panel/logs/
*.log


# ---------------------------------------------------------------------------
# Node / OS / editor cruft
# ---------------------------------------------------------------------------
node_modules/
.DS_Store
*.swp
*~
